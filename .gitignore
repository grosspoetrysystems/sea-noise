# macOS
.DS_Store

# Worktree provisioning (per orchestration_contract.parallelism_model = worktree-first)
.worktrees/

# Tempor tool state and planning workspace — fully untracked, both the
# hidden runtime dir and the visible planning dir.
.tempor/
tempor/

# Local agent state (per-machine metrics buffer for rule-injection hook).
# Shared agent infrastructure lives at .agents/shared/ and is tracked.
.agents/local/

# Python virtual environment for the parity capture procedure. The venv
# self-ignores (Python writes .venv/.gitignore with `*`); this rule is
# explicit for clarity. requirements.txt is committed.
.venv/

# Go build / test output
*.exe
*.dll
*.so
*.dylib
*.test
*.out
coverage.out
coverage.html
vendor/
dist/
bin/

# Local development output
tmp/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# Local secrets / env (never commit)
.env
.env.*
!.env.example
